# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000

# Auth (use a unique random value of at least 32 characters before production)
JWT_SECRET=replace-with-a-long-random-secret-before-deploy-123456

# Neo4j (local Docker defaults; change the password before production)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-before-production
NEO4J_DATABASE=ums

# Frontend public API origin
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
